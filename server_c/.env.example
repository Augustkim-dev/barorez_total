# ============================================================
# Server C — 환경 변수 템플릿
# 사용: 본 파일을 .env 로 복사 후 실제 값 채울 것 (.env 는 .gitignore)
# ============================================================

# Express HTTP 서버 포트 (Apache 리버스 프록시가 127.0.0.1:이 포트로 전달)
PORT=3000

# PHP 측 cfg/config.inc.php 의 PRINT_SHARED_SECRET 와 반드시 동일 값
# 비어있으면 부팅 실패 (HMAC 검증 무용지물 방지)
PRINT_SHARED_SECRET=

# PHP API 베이스 URL (ACK 콜백, 토큰 검증 등에 사용)
PHP_API_BASE=https://barorez.com

# SQLite 파일 경로 (server_c/ 기준 상대경로 또는 절대경로)
SQLITE_PATH=./data/server_c.db

# pino 로그 레벨: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# 개발 모드 여부 (true 일 때 pino-pretty 사용, 기본 false)
NODE_ENV=development
