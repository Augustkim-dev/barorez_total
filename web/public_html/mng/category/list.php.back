                <div id="categoryArea" class="depth-container"></div>

<!--                <pre id="output" class="mt-4" style="display: none">-->
                    <form method="post" name="frm_form" id="output" style="display: none" action="./update.php" target="hidden_ifrm" enctype="multipart/form-data">
